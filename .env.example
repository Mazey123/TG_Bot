# Скопируйте этот файл в .env и заполните значения.
# .env нельзя коммитить: там токен бота.

TELEGRAM_TOKEN=123456789:replace_me_with_botfather_token
BOT_TIMEZONE=Europe/Moscow

# Прокси для Bot API и внешних API. MTProto-прокси из Telegram-клиента
# (mtproto://) здесь НЕ работает: бот ходит в api.telegram.org по HTTPS.
# Нужен локальный SOCKS5/HTTP-порт или системный VPN.
# Примеры:
# PROXY_URL=socks5://127.0.0.1:1080
# PROXY_URL=socks5://user:password@host:port
# PROXY_URL=http://127.0.0.1:8080
# PROXY_URL=

DATABASE_URL=sqlite+aiosqlite:///./data/stock_bot.db

STARTING_BALANCE=10000.00
COMMISSION_RATE=0.002
DAILY_BONUS=250.00
BONUS_COOLDOWN_HOURS=24

# auto  — реальные API + честный fallback на кэш/демо-данные
# demo  — не ходить в сеть (для проверки без интернета)
MARKET_DATA_MODE=auto
HTTP_TIMEOUT_SECONDS=6
HTTP_RETRIES=2
PROVIDER_COOLDOWN_SECONDS=90

# Необязательный ключ публичного demo-тарифа CoinGecko
# COINGECKO_API_KEY=

ALERTS_ENABLED=true
ALERT_CHECK_INTERVAL_SECONDS=120

RATE_LIMIT_EVENTS=30
RATE_LIMIT_WINDOW_SECONDS=10
LOG_LEVEL=INFO
LOG_SALT=change_me_random_string
